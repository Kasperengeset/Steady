# OS / editor
.DS_Store
.vscode/
.idea/

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
frontend/dist/
frontend/dev-dist/

# Secrets – the pre-commit hook in scripts/git-hooks/ also blocks these and key patterns
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*client_secret*.json
*service-account*.json
token*.json

# Data – Androids Corpus must NEVER be committed (non-commercial, no redistribution)
data/
recorded_voice/
*.db
*.zip
# Audio in any letter case (Bad1.WAV): own recordings never go on GitHub either
*.[wW][aA][vV]
*.[wW][eE][bB][mM]
*.[oO][gG][gG]
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[fF][lL][aA][cC]
*.[oO][pP][uU][sS]
*.[aA][iI][fF][fF]

# backend/app/engine/weights/*.json IS committed: derived coefficients, not corpus data
