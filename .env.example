# Copy to .env (repo root) and fill in. .env is gitignored and the pre-commit hook blocks it.
# Never put a key in this file, in code, in the frontend (Vite VITE_* variables are public),
# or in a chat or issue. Test the key with: python scripts/check_gemini.py

# Gemini API key from the Junction sponsor / Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=

# Optional – defaults to <repo>/data/app.db
# DATABASE_URL=sqlite:////absolute/path/app.db
