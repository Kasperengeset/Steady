# Copy to .env (repo root) and fill in. .env is gitignored and the pre-commit hook blocks it.
# Never put a key in this file, in code, in the frontend (Vite VITE_* variables are public),
# or in a chat or issue. Test the key with: python scripts/check_gemini.py

# Gemini API key from the Junction sponsor / Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=

# Read-only Google Health connection. Keep all values in .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google-health/callback
FRONTEND_URL=http://localhost:5173
HEALTH_SYNC_ENABLED=true
WARMUP_MODELS=true
# Gemini content scores of diaries/transcripts (#28). Off: weight 0 until T28 passes (STATUS.md B33)
RATE_TEXT_ENABLED=false

# Optional – Web Push for the daily prompt (P2). `backend/.venv/bin/python scripts/gen_vapid.py` writes
# both keys into .env (private key never printed); then set the subject to a contact the push
# services can reach (mailto: or https:).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:

# Optional – defaults to <repo>/data/app.db
# DATABASE_URL=sqlite:////absolute/path/app.db
